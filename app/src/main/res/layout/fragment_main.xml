<?xml version="1.0" encoding="utf-8"?>
<!-- 主界面：横屏双栏布局，天气浮于时钟上方 -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="4dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- ============================================================
         左栏：时钟满屏 + 天气浮层
         ============================================================ -->
    <FrameLayout
        android:id="@+id/left_column"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/right_column"
        app:layout_constraintWidth_percent="0.5">

        <!-- 时钟填满整个左栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- 日期显示 -->
            <TextView
                android:id="@+id/date_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/syncing"
                android:textColor="@color/text_accent"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="0dp" />

            <!-- 时钟数字（LinearLayout，仅冒号负margin挤压，数字间距为0） -->
            <LinearLayout
                android:id="@+id/clock_row"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center|top"
                android:orientation="horizontal"
                android:clipChildren="false"
                android:clipToPadding="false">

                <TextView
                    android:id="@+id/time_hh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/text_white"
                    android:textSize="256sp"
                    android:textStyle="bold"
                    android:letterSpacing="0"
                    android:includeFontPadding="false"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/time_colon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":"
                    android:textColor="@color/text_white"
                    android:textSize="256sp"
                    android:textStyle="bold"
                    android:letterSpacing="0"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:layout_marginStart="-30dp"
                    android:layout_marginEnd="-30dp" />

                <TextView
                    android:id="@+id/time_mm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/text_white"
                    android:textSize="256sp"
                    android:textStyle="bold"
                    android:letterSpacing="0"
                    android:includeFontPadding="false"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/time_ss"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/text_gray"
                    android:textSize="92sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:layout_marginStart="0dp"
                    android:paddingBottom="28dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 天气浮层（底部，半透明背景） -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/weather_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="6dp"
            android:background="#DD1A1A1A"
            android:padding="8dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:elevation="8dp">

            <!-- 城市选择 + 设置按钮 -->
            <LinearLayout
                android:id="@+id/weather_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/city_selector"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="东莞 ▼"
                    android:textColor="@color/text_accent"
                    android:textSize="29sp"
                    android:textStyle="bold"
                    android:padding="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center" />
            </LinearLayout>

            <!-- 城市下拉列表 -->
            <LinearLayout
                android:id="@+id/city_dropdown"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FF222222"
                android:visibility="gone"
                android:elevation="16dp"
                app:layout_constraintTop_toBottomOf="@id/weather_header"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- 温度 + 天气图标行 -->
            <TextView
                android:id="@+id/temp_display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--°"
                android:textColor="@color/text_white"
                android:textSize="102sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp"
                app:layout_constraintTop_toBottomOf="@id/weather_header"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/weather_icon"
                app:layout_constraintHorizontal_chainStyle="packed" />

            <TextView
                android:id="@+id/weather_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☁"
                android:textSize="90sp"
                android:layout_marginStart="14dp"
                app:layout_constraintTop_toBottomOf="@id/weather_header"
                app:layout_constraintStart_toEndOf="@id/temp_display"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBaseline_toBaselineOf="@id/temp_display" />

            <!-- 天气描述 -->
            <TextView
                android:id="@+id/weather_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/loading"
                android:textColor="@color/text_gray"
                android:textSize="29sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"
                app:layout_constraintTop_toBottomOf="@id/temp_display"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 详细天气信息 -->
            <TextView
                android:id="@+id/weather_details"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="体感 --° | 湿度 --% | 风速 -- km/h"
                android:textColor="@color/text_dim"
                android:textSize="21sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"
                app:layout_constraintTop_toBottomOf="@id/weather_desc"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 3日预报（底部，完整显示） -->
            <LinearLayout
                android:id="@+id/forecast_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="4dp"
                android:paddingTop="4dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                app:layout_constraintTop_toBottomOf="@id/weather_details"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </FrameLayout>

    <!-- ============================================================
         右栏：日历
         ============================================================ -->
    <LinearLayout
        android:id="@+id/right_column"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="@drawable/weather_card_bg"
        android:padding="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/left_column"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.5">

        <!-- 月份标题 -->
        <TextView
            android:id="@+id/calendar_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="加载中…"
            android:textColor="@color/text_white"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <!-- 星期头 -->
        <LinearLayout
            android:id="@+id/weekday_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">

            <TextView style="@style/WeekdayCell" android:text="一" />
            <TextView style="@style/WeekdayCell" android:text="二" />
            <TextView style="@style/WeekdayCell" android:text="三" />
            <TextView style="@style/WeekdayCell" android:text="四" />
            <TextView style="@style/WeekdayCell" android:text="五" />
            <TextView style="@style/WeekdayCell" android:text="六" />
            <TextView style="@style/WeekdayCell" android:text="日" />
        </LinearLayout>

        <!-- 自定义 Canvas 日历网格（填充剩余空间） -->
        <com.calendardesk.util.CalendarGridView
            android:id="@+id/calendar_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 当天万年历/黄历内容（紧凑、加粗，不挤占日历） -->
        <TextView
            android:id="@+id/almanac_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="2dp"
            android:gravity="center"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="3"
            android:ellipsize="end"
            android:includeFontPadding="false" />

    </LinearLayout>

    <!-- ============================================================
         浮动控件：全屏按钮（右下）+ 校准栏（左上）
         ============================================================ -->
    <TextView
        android:id="@+id/btn_fullscreen"
        style="@style/FloatingBtn"
        android:text="⛶"
        android:layout_margin="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/calibration_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_margin="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/btn_cal_sync"
            style="@style/CaliBtn"
            android:text="↻" />

        <!-- API Key 快捷按钮 -->
        <TextView
            android:id="@+id/btn_api_key_bar"
            style="@style/CaliBtn"
            android:text="🔑"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <!-- 日历月份浏览按钮：左（上一月）/ 右（下一月），浮于日历左右两侧 -->
    <TextView
        android:id="@+id/btn_cal_prev"
        style="@style/NavBtn"
        android:text="◀"
        android:layout_marginStart="6dp"
        app:layout_constraintStart_toStartOf="@id/right_column"
        app:layout_constraintTop_toTopOf="@id/right_column"
        app:layout_constraintBottom_toBottomOf="@id/right_column" />

    <TextView
        android:id="@+id/btn_cal_next"
        style="@style/NavBtn"
        android:text="▶"
        android:layout_marginEnd="6dp"
        app:layout_constraintEnd_toEndOf="@id/right_column"
        app:layout_constraintTop_toTopOf="@id/right_column"
        app:layout_constraintBottom_toBottomOf="@id/right_column" />

</androidx.constraintlayout.widget.ConstraintLayout>
