<?xml version="1.0" encoding="utf-8"?>
<!-- 设置页面 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="20dp">

    <!-- 工具栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <TextView
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="←"
            android:textColor="@color/text_white"
            android:textSize="24sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/cali_btn_bg" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings"
            android:textColor="@color/text_white"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp" />
    </LinearLayout>

    <!-- API Key 设置区 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/api_key_label"
        android:textColor="@color/text_accent"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/et_api_key"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:textColor="@color/text_white"
        android:textColorHint="@color/text_dim"
        android:hint="输入32位API Key"
        android:textSize="16sp"
        android:inputType="text"
        android:maxLength="40"
        android:padding="12dp"
        android:background="#FF222222"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_reset_key"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="@string/reset_default"
            android:textColor="@color/text_white"
            android:textSize="16sp"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:clickable="true"
            android:focusable="true"
            android:background="#FF333333" />

        <TextView
            android:id="@+id/btn_save_key"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="@string/save"
            android:textColor="@color/bg_dark"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@color/text_accent"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <!-- 分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp" />

    <!-- 时间微调区 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/time_calibration"
        android:textColor="@color/text_accent"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/btn_plus"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:text="+1s"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/cali_btn_bg" />

        <TextView
            android:id="@+id/btn_minus"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:text="-1s"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/cali_btn_bg"
            android:layout_marginStart="16dp" />

        <TextView
            android:id="@+id/btn_reset"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:text="@string/resync"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/cali_btn_bg"
            android:layout_marginStart="16dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_offset_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="当前偏移: 0.0 秒"
        android:textColor="@color/text_dim"
        android:textSize="16sp"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/tv_sync_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="同步状态: 等待中…"
        android:textColor="@color/text_dim"
        android:textSize="16sp"
        android:layout_marginTop="6dp" />

    <!-- 分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp" />

    <!-- 默认城市选择 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/default_city_label"
        android:textColor="@color/text_accent"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:id="@+id/city_list_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp" />

    <!-- 关于信息 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginBottom="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/about"
        android:textColor="@color/text_accent"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/version"
        android:textColor="@color/text_dim"
        android:textSize="16sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="和风天气 API Key 可在 dev.qweather.com 免费申请"
        android:textColor="@color/text_dim"
        android:textSize="14sp"
        android:layout_marginTop="6dp" />

</LinearLayout>
